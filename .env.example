# 六条线路均为 OpenAI chat.completions 兼容接口。
# 每条主线路缺失或运行失败时，当前模块在本次进程内固定切到 BACKUP。

LLM_REQUIREMENTS_API_KEY=your-requirements-api-key
LLM_REQUIREMENTS_BASE_URL=https://your-requirements-endpoint.example.com/v1
LLM_REQUIREMENTS_MODEL=your-requirements-model
LLM_REQUIREMENTS_TIMEOUT_SECONDS=120
LLM_REQUIREMENTS_STREAM=false

LLM_EVALUATION_API_KEY=your-evaluation-api-key
LLM_EVALUATION_BASE_URL=https://your-evaluation-endpoint.example.com/v1
LLM_EVALUATION_MODEL=your-evaluation-model
LLM_EVALUATION_TIMEOUT_SECONDS=120
LLM_EVALUATION_STREAM=false

LLM_AUDIT_API_KEY=your-audit-api-key
LLM_AUDIT_BASE_URL=https://your-audit-endpoint.example.com/v1
LLM_AUDIT_MODEL=your-audit-model
LLM_AUDIT_TIMEOUT_SECONDS=120
LLM_AUDIT_STREAM=false

LLM_PORTFOLIO_API_KEY=your-portfolio-api-key
LLM_PORTFOLIO_BASE_URL=https://your-portfolio-endpoint.example.com/v1
LLM_PORTFOLIO_MODEL=your-portfolio-model
LLM_PORTFOLIO_TIMEOUT_SECONDS=120
LLM_PORTFOLIO_STREAM=false

LLM_ADVICE_API_KEY=your-advice-api-key
LLM_ADVICE_BASE_URL=https://your-advice-endpoint.example.com/v1
LLM_ADVICE_MODEL=your-advice-model
LLM_ADVICE_TIMEOUT_SECONDS=120
LLM_ADVICE_STREAM=false

LLM_BACKUP_API_KEY=your-backup-api-key
LLM_BACKUP_BASE_URL=https://your-backup-endpoint.example.com/v1
LLM_BACKUP_MODEL=your-backup-model
LLM_BACKUP_TIMEOUT_SECONDS=120
LLM_BACKUP_STREAM=false

# 是否让所有线路读取 HTTP_PROXY/HTTPS_PROXY；使用 Clash TUN 时建议 false。
LLM_TRUST_ENV=false
